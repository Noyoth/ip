<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root alignment="TOP_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="388.0" spacing="10.0" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <VBox alignment="TOP_CENTER" maxWidth="75.0" minWidth="75.0" prefWidth="75.0" spacing="4.0" style="-fx-border-color: transparent #dddddd transparent transparent; -fx-border-width: 0 1 0 0; -fx-padding: 0 8 0 0;">
      <children>
        <ImageView fx:id="displayPicture" fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true" />
        <Label fx:id="speakerName" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #555555;" text="Speaker" />
      </children>
    </VBox>
    <Label fx:id="dialog" maxHeight="1.7976931348623157E308" style="-fx-font-size: 13px;" text="Label" wrapText="true" HBox.hgrow="ALWAYS" />
  </children>
  <padding>
    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
  </padding>
</fx:root>
